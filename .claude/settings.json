{
  "permissions": {
    "allow": [
      "Bash(./dev *)",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(playwright *)",
      "Bash(tsc *)",
      "Bash(vite *)",
      "Bash(vitest *)",
      "Bash(oxlint *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-docker.sh"
          }
        ]
      }
    ]
  }
}
