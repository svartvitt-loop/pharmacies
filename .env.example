# Copy to .env (git-ignored) and adjust; docker compose reads it automatically.

# Your user and group IDs (`id -u`, `id -g`). Files the containers write are owned by them.
HOST_UID=1000
HOST_GID=1000

# This machine's LAN address, for the `lan` profile (testing from phones):
#   ip route get 1.1.1.1 | grep -oP 'src \K\S+'
LAN_IP=
