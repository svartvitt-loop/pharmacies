#!/usr/bin/env bash
# Runs the project's dev tasks in containers, so only Docker is needed on the host.
# Usage: ./dev <task> [args…]; ./dev help lists the tasks.
set -euo pipefail
cd "$(dirname "$0")"

# One-off container; --no-deps skips the data step that `docker compose up` runs first.
run() { docker compose run --rm --no-deps "$@"; }

usage() {
  cat <<'EOF'
Usage: ./dev <task> [args…]

  up [args…]          docker compose up (data + dev server on http://localhost:5173)
  lint                oxlint (web); ruff check and format check (scraper)
  typecheck           tsc -b (web: app, config files and e2e tests)
  build               type-check + production build into web/dist
  test [args…]        unit tests (web/src/*.test.ts, Vitest); args go to vitest
  e2e [args…]         Playwright smoke tests in Google Chrome; args go to playwright test
  scraper-test [args…] pytest (scraper)
  check               lint, typecheck, test, scraper-test and e2e
  npm|npx …           any npm/npx command in the web container, e.g. ./dev npm install leaflet
  uv|python|pytest|ruff …  any of these in the scraper container, e.g. ./dev ruff format
  sh [service]        shell in a container (web by default; data, e2e)
EOF
}

task=${1:-help}
[ $# -gt 0 ] && shift

case "$task" in
  up)                exec docker compose up "$@" ;;
  lint)              run web npm run lint && run data uv run --locked sh -c 'ruff check && ruff format --check' ;;
  typecheck)         run web npm run typecheck ;;
  build)             run web npm run build ;;
  test)              run web npm test -- "$@" ;;
  e2e)               run e2e npm run test:e2e -- "$@" ;;
  scraper-test)      run data uv run --locked pytest -q "$@" ;;
  check)             "$0" lint && "$0" typecheck && "$0" test && "$0" scraper-test && "$0" e2e ;;
  npm | npx)         run web "$task" "$@" ;;
  uv)                run data uv "$@" ;;
  # uv run syncs the environment (a volume) from uv.lock first.
  python | pytest | ruff) run data uv run --locked "$task" "$@" ;;
  sh)                run "${1:-web}" sh ;;
  help | -h | --help) usage ;;
  *)                 usage >&2; exit 2 ;;
esac
